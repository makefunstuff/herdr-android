    sys.stderr.flush()


# ---- sealing -------------------------------------------------------------------------------------
#
# hp1.<base64url(nonce ‖ ciphertext ‖ tag)>, without padding. Two keys come from the shared one:
# enc = HMAC(key, "herdr-push enc"), mac = HMAC(key, "herdr-push mac"). The keystream is
# HMAC-SHA256(enc, nonce ‖ counter) for counter 0, 1, … (32-bit big-endian), XORed with the
# zlib-compressed JSON; tag = HMAC-SHA256(mac, "hp1" ‖ nonce ‖ ciphertext). HMAC-SHA256 as a PRF in
# counter mode, then encrypt-then-MAC: only the standard library's hmac and hashlib. The app's
# core/…/push/PushSeal.kt opens it.

def _hmac(key, data):
    return hmac.new(key, data, hashlib.sha256).digest()


def seal(key, plain, nonce=None):
    nonce = nonce if nonce is not None else os.urandom(16)
    enc = _hmac(key, b"herdr-push enc")
    mac = _hmac(key, b"herdr-push mac")
    stream = bytearray()
    counter = 0
    while len(stream) < len(plain):
        stream += _hmac(enc, nonce + counter.to_bytes(4, "big"))
        counter += 1
    ct = bytes(a ^ b for a, b in zip(plain, stream))
    tag = _hmac(mac, b"hp1" + nonce + ct)
    return "hp1." + base64.urlsafe_b64encode(nonce + ct + tag).decode().rstrip("=")


def seal_message(key, message):
    return seal(key, zlib.compress(json.dumps(message, separators=(",", ":"), ensure_ascii=False).encode(), 9))


# ---- files ---------------------------------------------------------------------------------------

def read_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def write_json(path, value, private=False):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600 if private else 0o644)
    with os.fdopen(fd, "w") as f:
        json.dump(value, f, indent=1)
    os.replace(tmp, path)


def subscribers():
    subs = read_json(SUBSCRIBERS, [])
    return [s for s in subs if isinstance(s, dict) and s.get("id") and s.get("endpoint") and s.get("key")]


