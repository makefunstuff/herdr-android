def find_board(sub):
    for c in (sub.get("board"), os.path.join(HOME, ".herdr-projects", "data", "bin", "herdr-projects"),
              shutil.which("herdr-projects"), os.path.join(HOME, ".local", "bin", "herdr-projects")):
        if c and os.access(c, os.X_OK):
            return c
    return None


class Source:
    """One herdr session on this machine, with the board next to it: what a group of phones watch."""

    def __init__(self, session, herdr, board):
        self.session = session or "default"
        self.herdr = herdr
        self.board = board

    @property
    def key(self):
        return self.session

    def env(self):
        env = dict(os.environ)
        # The watcher may run inside a herdr pane (tests, `once`): its own session must not win.
        for k in ("HERDR_SOCKET_PATH", "HERDR_CLIENT_SOCKET_PATH", "HERDR_PANE_ID", "HERDR_TAB_ID", "HERDR_WORKSPACE_ID"):
            env.pop(k, None)
        if self.session != "default":
            env["HERDR_SESSION"] = self.session
        else:
            env.pop("HERDR_SESSION", None)
        if self.herdr:
            env["HERDR_BIN_PATH"] = self.herdr
            env["PATH"] = os.path.dirname(self.herdr) + os.pathsep + env.get("PATH", "/usr/bin:/bin")
        return env

    def run(self, args, timeout=20):
        r = subprocess.run(args, env=self.env(), stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                           stderr=subprocess.PIPE, timeout=timeout)
        if r.returncode != 0:
            raise RuntimeError((r.stderr.decode(errors="replace").strip().splitlines() or ["exit %d" % r.returncode])[-1])
        return r.stdout.decode(errors="replace")

    def snapshot(self):
        out = json.loads(self.run([self.herdr, "api", "snapshot"]))
        snap = (out.get("result") or {}).get("snapshot") or out.get("snapshot") or out
        return snap

    def screen(self, pane):
        try:
            text = self.run([self.herdr, "pane", "read", pane, "--source", "visible", "--lines", "60"])
        except Exception as e:  # noqa: BLE001 - a screen is a nicety
            log("can't read", pane, e)
            return None
        return trim_screen(text)

    def tasks(self):
        """`list --json` with each task's short key from the plain list, matched as the app does."""
        tasks = json.loads(self.run([self.board, "list", "--json"], timeout=30) or "[]")
        if not isinstance(tasks, list):
            return []
        try:
            plain = self.run([self.board, "list"], timeout=30)
        except Exception:  # noqa: BLE001
            plain = ""
        rows = [l.strip().split(" ")[0] for l in plain.splitlines() if l.strip()]
        keyed = len(rows) == len(tasks)
        out = []
        for i, t in enumerate(tasks):
            if not isinstance(t, dict) or not t.get("id"):
                continue
            key = ""
            if keyed and "-" in rows[i] and rows[i].rsplit("-", 1)[1] == str(t["id"]).rsplit("/", 1)[-1]:
                key = rows[i]
            out.append((key, t))
        return out


    def review_rounds(self, task_id):
        """How many times the board sends work back by itself for this task (`review.rounds`), or None."""
        try:
            out = self.run([self.board, "show", task_id], timeout=30)
        except Exception as e:  # noqa: BLE001 - the chip then shows the round alone
            log("can't read the settings of", task_id, e)
            return None
        for line in out.splitlines():
            parts = line.split()
            if len(parts) >= 2 and parts[0] == "review.rounds" and parts[1].isdigit():
                return int(parts[1])
        return None


def trim_screen(text):
    lines = text.rstrip().splitlines()[-40:]
    text = "\n".join(l.rstrip() for l in lines)
    return text[-SCREEN_CHARS:]


def location(snap, agent):
    ws = next((w for w in snap.get("workspaces", []) if w.get("workspace_id") == agent.get("workspace_id")), {})
    tab = next((t for t in snap.get("tabs", []) if t.get("tab_id") == agent.get("tab_id")), {})
    return "%s › %s" % (ws.get("label") or agent.get("workspace_id", ""), tab.get("label") or agent.get("tab_id", ""))


# ---- what changed --------------------------------------------------------------------------------

def agent_events(source, snap, seen, first):
    """Agents that became blocked or done, and ones that were and no longer are. Updates [seen]."""
    events = []
    now = {}
    for a in snap.get("agents", []):
        pane = a.get("pane_id")
        if not pane:
            continue
        status = a.get("agent_status", "unknown")
        now[pane] = status
        before = seen.get(pane)
        if first or status == before:
            continue
        if status in ("blocked", "done") or before in ("blocked", "done"):
            ev = {"type": "agent", "agent": a, "where": location(snap, a)}
            if status == "blocked":
                ev["screen"] = source.screen(pane)
            events.append(ev)
    for pane, before in seen.items():
        if pane not in now and before in ("blocked", "done"):
            events.append({"type": "agent", "agent": {"pane_id": pane, "workspace_id": "", "tab_id": "", "agent_status": "gone"},
                           "where": ""})
    seen.clear()
    seen.update(now)
    return events


def needs_you(task):
    return not task.get("archivedAt") and (task.get("state") in ("blocked", "error") or task.get("stage") in NEEDS_YOU_STAGES)


def task_sig(task):
    review = task.get("review") or {}
    return json.dumps([task.get("state"), task.get("stage"), task.get("kind"), task.get("reviewRound"),
                       review.get("pass", review.get("meets")), bool(task.get("mergeFailed") or task.get("prFailure"))])


def task_events(tasks, seen, first):
    """Tasks that started waiting for you (or wait for something else now), and ones that stopped."""
    events = []
    now = {}
    for key, t in tasks:
        sig = task_sig(t) if needs_you(t) else ""
        now[t["id"]] = sig
        before = seen.get(t["id"], "")
        if first or sig == before:
            continue
        if sig or before:
            events.append({"type": "task", "key": key, "task": t})
    for tid, before in seen.items():
        if tid not in now and before:
            events.append({"type": "task", "key": "", "task": {"id": tid, "state": "gone"}})
    seen.clear()
    seen.update(now)
    return events


# ---- what is running (Live Updates) --------------------------------------------------------------

def running_task(task):
    """A task whose agent works on it now: not waiting for you, not queued, not another machine's."""
    return (task.get("state") == "working" and not needs_you(task) and not task.get("archivedAt")
            and task.get("stage") not in QUEUED_STAGES and ":" not in str(task.get("id", "")))


def stage_group(stage):
    """The part of a task's run a board stage belongs to; a new part restarts the time shown."""
    if stage in ("checking", "pushing"):
        return "check"
    if stage in ("reviewing", "reviewneeds"):
        return "review"
    if stage == "merging":
        return "land"
    return "work"


def _short(text, n=160):
    text = str(text or "")
    return text if len(text) <= n else text[:n - 1] + "…"


def live_agents(snap, st, now):
    """The working agents, each with when it started working (as this watcher first saw it)."""
    since = st.setdefault("live_agents_since", {})
    out = []
    for a in snap.get("agents", []):
        pane = a.get("pane_id")
        if not pane or a.get("agent_status") != "working":
            continue
        since.setdefault(pane, int(now))
        keep = ("pane_id", "workspace_id", "tab_id", "agent", "name", "title", "display_agent", "agent_status", "state_change_seq")
        agent = {k: (_short(a[k]) if isinstance(a[k], str) else a[k]) for k in keep if a.get(k) is not None}
        ws = next((w for w in snap.get("workspaces", []) if w.get("workspace_id") == a.get("workspace_id")), {})
        # The workspace's label: the board names a task's workspace after it, which ties its agents (worker, reviewer) to it.
        out.append({"agent": agent, "where": _short(location(snap, a), 80), "workspace": _short(ws.get("label"), 80), "since": since[pane]})
    working = {e["agent"]["pane_id"] for e in out}
    for pane in list(since):
        if pane not in working:
            del since[pane]
    return out[:LIVE_MAX]


def live_tasks(source, tasks, st, now):
    """The running tasks, each with when its current part of the run started and its most reviews."""
    since = st.setdefault("live_tasks_since", {})
    rounds = st.setdefault("review_rounds", {})
    out = []
    for key, t in tasks:
        if not running_task(t):
            continue
        tid = t["id"]
        group = stage_group(t.get("stage"))
        if (since.get(tid) or [None])[0] != group:
            since[tid] = [group, int(now)]
        keep = ("id", "title", "state", "stage", "msg", "progress", "eta", "reviewRound", "app")
        task = {k: (_short(t[k]) if isinstance(t[k], str) else t[k]) for k in keep if t.get(k) is not None}
        item = {"key": key, "task": task, "since": since[tid][1]}
        if group == "review":
            known = rounds.get(tid)
            if not known or now - known[1] > 3600:
                known = rounds[tid] = [source.review_rounds(tid), int(now)]
            if known[0] is not None:
                # The first review, then one after each time the work went back.
                item["reviews"] = known[0] + 1
        out.append(item)
    running = {i["task"]["id"] for i in out}
    for tid in list(since):
        if tid not in running:
            del since[tid]
    for tid in list(rounds):
        if tid not in running:
            del rounds[tid]
    return out[:LIVE_MAX]


def live_sigs(event):
    """What starts, stops or changes stage (sent at once), and that with the rest (sent now and then)."""
    major, minor = [], []
    for e in event.get("agents", []):
        a = e["agent"]
        major.append(["a", a.get("pane_id")])
        minor.append(["a", a.get("pane_id"), a.get("name"), a.get("title")])
    for e in event.get("tasks", []):
        t = e["task"]
        major.append(["t", t.get("id"), stage_group(t.get("stage")), t.get("reviewRound"), e.get("reviews")])
        minor.append(["t", t.get("id"), t.get("stage"), t.get("progress"), t.get("eta"), t.get("msg")])
    return json.dumps(major), json.dumps(minor)


def live_event(st, agents, tasks, now, first):
    """The live event to send now, or None: [agents] and [tasks] are None when not looked at this time."""
    if agents is not None:
        st["live_agents"] = agents
    if tasks is not None:
        st["live_tasks"] = tasks
    event = {"type": "live", "agents": st.get("live_agents", [])}
    if "live_tasks" in st:
        event["tasks"] = st["live_tasks"]
    major, minor = live_sigs(event)
    sent = st.get("live_sent") or {}
    since = now - float(sent.get("at") or 0)
    busy = bool(event["agents"] or event.get("tasks"))
    due = (first or not sent or major != sent.get("major")
           or (minor != sent.get("minor") and since >= LIVE_MINOR)
           or (busy and since >= LIVE_KEEP))
    if not due:
        return None
    st["live_sent"] = {"at": now, "major": major, "minor": minor}
    return event


# ---- health (RAM, CPU, disks) --------------------------------------------------------------------

def read_memory():
    """{"total", "available", "swap_total", "swap_free"} in KiB, from /proc/meminfo; None elsewhere."""
    try:
        with open(MEMINFO) as f:
            m = {}
            for line in f:
                k, _, v = line.partition(":")
                parts = v.split()
                if parts and parts[0].isdigit():
                    m[k.strip()] = int(parts[0])
    except OSError:
        return None
    if "MemTotal" not in m:
        return None
    avail = m.get("MemAvailable", m.get("MemFree", 0) + m.get("Buffers", 0) + m.get("Cached", 0))
    return {"total": m["MemTotal"], "available": min(avail, m["MemTotal"]),
            "swap_total": m.get("SwapTotal", 0), "swap_free": m.get("SwapFree", 0)}


def read_cpu():
    """(total, idle) CPU ticks so far, from /proc/stat; None elsewhere."""
    try:
        with open("/proc/stat") as f:
            x = [int(v) for v in f.readline().split()[1:9]]
    except (OSError, ValueError):
        return None
    return (sum(x), x[3] + (x[4] if len(x) > 4 else 0)) if len(x) >= 4 else None


def read_disks():
    """The real filesystems from `df -kPT` (or `-kP`), as the app picks them: [{"mount", "total", "used", "avail"}]."""
    out = ""
    if DF:
        with open(DF) as f:
            out = f.read()
    for args in ([] if DF else [["df", "-kPT"], ["df", "-kP"]]):
        try:
            r = subprocess.run(args, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=15)
        except Exception:  # noqa: BLE001
            continue
        if r.returncode == 0 or r.stdout:
            out = r.stdout.decode(errors="replace")
            break
    lines = out.splitlines()
    if not lines:
        return []
    typed = "Type" in lines[0]
    pat = re.compile(r"^(.+?)\s+(\S+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)%\s+(/.*)$" if typed else
                     r"^(.+?)\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)%\s+(/.*)$")
    found = []
    for line in lines[1:]:
        m = pat.match(line)
        if not m:
            continue
        g = m.groups()
        dev, fstype = g[0].strip(), (g[1] if typed else "")
        total, used, avail, mount = (int(g[2]), int(g[3]), int(g[4]), g[6]) if typed else (int(g[1]), int(g[2]), int(g[3]), g[5])
        if total <= 0 or fstype in SKIP_FS or (not typed and not dev.startswith("/")):
            continue
        if any(mount == s or mount.startswith(s.rstrip("/") + "/") for s in SKIP_MOUNTS):
            continue
        found.append({"mount": mount, "device": dev, "total": total, "used": used, "avail": avail})
    found.sort(key=lambda d: len(d["mount"]))
    out, seen = [], set()
    for d in found:
        keys = {d["device"] if d["device"].startswith("/") else None, "%d/%d" % (d["total"], d["avail"])} - {None}
        if keys & seen:
            continue
        seen |= keys
        out.append(d)
    return out


def proc_name(args):
    """What to call a process in a warning, as the app does for the ones worth calling out."""
    exe = args.split(" ", 1)[0].rsplit("/", 1)[-1]
    if exe.startswith("qemu-system") or exe.startswith("emulator"):
        avd = re.search(r"(?:^|\s)-avd\s+(\S+)", args)
        if avd or "/emulator/" in args or "android" in args.lower():
            return "Android emulator" + (" · " + avd.group(1) if avd else "")
        return "QEMU VM"
    if "GradleDaemon" in args:
        return "Gradle daemon"
    if "KotlinCompileDaemon" in args:
        return "Kotlin daemon"
    return exe


def top_memory(n=3):
    """The [n] processes using the most memory: [name, KiB], biggest first."""
    try:
        r = subprocess.run(["ps", "-axo", "rss=,args="], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                           stderr=subprocess.DEVNULL, timeout=15)
    except Exception:  # noqa: BLE001
        return []
    rows = []
    for line in r.stdout.decode(errors="replace").splitlines():
        parts = line.strip().split(None, 1)
        if len(parts) == 2 and parts[0].isdigit():
            rows.append((int(parts[0]), parts[1]))
    rows.sort(reverse=True)
    return [[proc_name(a), kb] for kb, a in rows[:n]]


def disk_limit(d):
    return min((d["used"] + d["avail"]) // 10, DISK_CAP_KB)


def health_low(mem, disks):
    """What is low: "ram" and "disk:<mount>" (disks bigger than 1 GB)."""
    low = []
    if mem and mem["total"] > 0 and mem["available"] * 100.0 / mem["total"] < RAM_LOW:
        low.append("ram")
    low += ["disk:" + d["mount"] for d in disks if d["used"] + d["avail"] > 1024 * 1024 and d["avail"] < disk_limit(d)]
    return low


def health_fine(mem, disks):
    ram = not mem or mem["total"] == 0 or mem["available"] * 100.0 / mem["total"] >= RAM_OK
    return ram and all(d["avail"] >= disk_limit(d) * 3 // 2 for d in disks if d["used"] + d["avail"] > 1024 * 1024)


def health_look(st, now):
    """Every HEALTH_EVERY seconds: notes a point of the hour's history, and returns the health event to send, or None."""
    if HEALTH_EVERY <= 0 or now - float(st.get("at") or 0) < HEALTH_EVERY:
        return None
    st["at"] = now
    mem = read_memory()
    cpu = read_cpu()
    disks = read_disks()
    busy = None
    if cpu and st.get("cpu"):
        dt = cpu[0] - st["cpu"][0]
        if dt > 0:
            busy = round(100.0 * (dt - (cpu[1] - st["cpu"][1])) / dt, 1)
    st["cpu"] = list(cpu) if cpu else None
    if mem:
        points = [p for p in read_json(HEALTH, {}).get("points", []) if isinstance(p, list) and now - p[0] <= HEALTH_KEEP]
        used = round(100.0 - mem["available"] * 100.0 / mem["total"], 1) if mem["total"] else 0
        swap = round((mem["swap_total"] - mem["swap_free"]) * 100.0 / mem["swap_total"], 1) if mem["swap_total"] else 0
        points.append([int(now), used, swap, busy])
        write_json(HEALTH, {"v": 1, "points": points})
    low = health_low(mem, disks)
    before = st.get("low") or []
    if low:
        if sorted(low) == sorted(before):
            return None
        st["low"] = low
        return {"type": "health", "low": low, "memory": mem,
                "disks": [d for d in disks if "disk:" + d["mount"] in low], "top": top_memory()}
    if before and health_fine(mem, disks):
        st["low"] = []
        return {"type": "health", "low": []}
    return None


# ---- quick commands ------------------------------------------------------------------------------

def quick_look(st, now):
    """The AI quick commands that ended since the last look, as events; the first look only learns."""
    try:
        ids = sorted(os.listdir(QUICK_DIR))[-200:]
    except OSError:
        ids = []
    first = "seen" not in st
    seen = st.get("seen") or {}
    events, keep = [], {}
    for rid in ids:
        run = os.path.join(QUICK_DIR, rid)
        status = read_json(os.path.join(run, "status.json"), None)
        if not isinstance(status, dict) or status.get("state") not in QUICK_ENDED:
            continue
        state = status["state"]
        keep[rid] = state
        if first or seen.get(rid) == state or state == "stopped":
            continue
        if now - float(status.get("ended") or now) > QUICK_FRESH:
            continue
        meta = read_json(os.path.join(run, "meta.json"), {})
        if not isinstance(meta, dict) or meta.get("kind") != "prompt":
            continue
        answer = ""
        try:
            with open(os.path.join(run, "answer.md"), encoding="utf-8", errors="replace") as f:
                answer = f.read(600)
        except OSError:
            pass
        events.append({"type": "quick", "id": rid, "name": _short(meta.get("name") or rid, 80), "state": state,
                       "error": _short(status.get("error") or "", 200), "text": _short(answer.strip(), 300),
                       "cwd": meta.get("cwd") or ""})
    st["seen"] = keep
    return events


# ---- the journal (the app's brief) ---------------------------------------------------------------

def task_phase(task):
    """What the brief tells apart about a task: done, waiting for you (and on what), queued, working, to do."""
    if task.get("archivedAt"):
        return "archived"
    if task.get("state") == "done":
        return "done"
    if needs_you(task):
        return "needs " + task_sig(task)
    if task.get("stage") in QUEUED_STAGES:
        return "queued"
    if task.get("state") == "working":
        return "working"
    return "todo"


def small_task(task):
    """A task as the journal keeps it: what the app needs to name it and tell how it stands."""
    keep = ("id", "title", "state", "stage", "kind", "msg", "pr", "research", "reviewRound", "app",
            "mergeFailed", "syncBlocked", "prFailure", "prState", "archivedAt")
    out = {k: (_short(task[k], 240) if isinstance(task[k], str) else task[k]) for k in keep if task.get(k) is not None}
    review = task.get("review")
    if isinstance(review, dict):
        out["review"] = {k: review[k] for k in ("pass", "meets") if k in review}
    return out


def journal_tasks(tasks, seen, first, now):
    """A journal entry for each task whose phase changed (or that is new) since the last look. Updates [seen]."""
    entries = []
    now_seen = {}
    for key, t in tasks:
        tid = str(t.get("id", ""))
        # Another machine's task: that machine keeps its own journal.
        if not tid or ":" in tid:
            continue
        phase = task_phase(t)
        now_seen[tid] = phase
        before = seen.get(tid)
        if first or phase == before:
            continue
        entries.append({"at": int(now), "type": "task", "key": key, "task": small_task(t),
                        "was": before.split(" ")[0] if before else "new"})
    seen.clear()
    seen.update(now_seen)
    return entries


def journal_agents(snap, seen, first, now):
    """A journal entry for each agent that finished or started asking since the last look. Updates [seen]."""
    entries = []
    now_seen = {}
    for a in snap.get("agents", []):
        pane = a.get("pane_id")
        if not pane:
            continue
        status = a.get("agent_status", "unknown")
        # The state's number: an agent that finished again since the last look still counts once more.
        mark = "%s#%s" % (status, a.get("state_change_seq", ""))
        now_seen[pane] = mark
        if first or mark == seen.get(pane) or status not in ("done", "blocked"):
            continue
        keep = ("pane_id", "workspace_id", "tab_id", "agent", "name", "title", "display_agent", "agent_status", "state_change_seq")
        agent = {k: (_short(a[k]) if isinstance(a[k], str) else a[k]) for k in keep if a.get(k) is not None}
        ws = next((w for w in snap.get("workspaces", []) if w.get("workspace_id") == a.get("workspace_id")), {})
        entries.append({"at": int(now), "type": "agent", "agent": agent, "where": _short(location(snap, a), 80),
                        "workspace": _short(ws.get("label"), 80)})
    seen.clear()
    seen.update(now_seen)
    return entries


def journal_add(key, entries, now):
    """Adds [entries] to session [key]'s journal, dropping what is older than JOURNAL_DAYS."""
    j = read_json(JOURNAL, {})
    sessions = j.setdefault("sessions", {})
    s = sessions.setdefault(key, {})
    s.setdefault("from", int(now))
    keep = now - JOURNAL_DAYS * 86400
    s["entries"] = ([e for e in s.get("entries", []) if isinstance(e, dict) and float(e.get("at") or 0) >= keep] + entries)[-JOURNAL_MAX:]
    j["v"] = 1
    write_json(JOURNAL, j)


def journal_start(key, now):
    """The first look at session [key]: from now on its journal is complete."""
    j = read_json(JOURNAL, {})
    s = j.setdefault("sessions", {}).setdefault(key, {})
    if "from" not in s:
        s["from"] = int(now)
        s.setdefault("entries", [])
        j["v"] = 1
        write_json(JOURNAL, j)


# ---- sending -------------------------------------------------------------------------------------

def messages(events):
    """The events in as few pushes as fit, shortening a screen that alone is too long."""
    host = socket.gethostname()
    out, batch = [], []
    for ev in events:
        # One live event can't be split: what is running goes out shortest first, and the rest is left off.
        while ev.get("type") == "live" and _too_big(host, [ev]) and (ev.get("agents") or ev.get("tasks")):
            longer = "tasks" if len(ev.get("tasks") or []) >= len(ev.get("agents") or []) else "agents"
            ev[longer] = ev[longer][:-1]
        if batch and _too_big(host, batch + [ev]):
            out.append(batch)
            batch = []
        batch.append(ev)
        while _too_big(host, batch) and ev.get("screen"):
            ev["screen"] = ev["screen"][len(ev["screen"]) // 2:] if len(ev["screen"]) > 200 else None
    if batch:
        out.append(batch)
    return [{"v": 1, "host": host, "at": int(time.time()), "events": b} for b in out]


def _too_big(host, batch):
    msg = {"v": 1, "host": host, "at": int(time.time()), "events": batch}
    return len(seal_message(b"\0" * 32, msg)) > MAX_SEALED


def gone(record, sub):
    """Whether the push server said this phone's address is gone since the phone last subscribed."""
    return float(record.get("gone") or 0) > float(sub.get("since") or 0)


def shows(event):
    """Whether [event] puts a notification up (rather than taking one down)."""
    if event.get("type") == "agent":
        return event["agent"].get("agent_status") in ("blocked", "done")
    if event.get("type") == "task":
        return needs_you(event["task"])
    if event.get("type") == "live":
        return False
    if event.get("type") == "health":
        return bool(event.get("low"))
    return True


def post(sub, text, urgent):
    req = urllib.request.Request(sub["endpoint"], data=text.encode(), method="POST", headers={
        "Content-Type": "text/plain",
        "TTL": "86400",
        "Urgency": "high" if urgent else "normal",
    })
    with urllib.request.urlopen(req, timeout=15) as r:
        r.read()


def send(sub, events, record):
    """Sends [events] to one phone, a few tries each; notes how it went in [record]."""
    key = base64.b64decode(sub["key"])
    urgent = any(shows(e) for e in events)
    ok = True
    for msg in messages(events):
        text = seal_message(key, msg)
        for attempt in range(3):
            try:
                post(sub, text, urgent)
                record["ok"] = int(time.time())
                record.pop("error", None)
                break
            except urllib.error.HTTPError as e:
                record["error"] = "HTTP %d from %s" % (e.code, urllib.parse.urlsplit(sub["endpoint"]).netloc)
                if e.code in (404, 410):
                    # The push app dropped this address; the phone gives a new one when it connects.
                    record["gone"] = time.time()
                    return False
            except Exception as e:  # noqa: BLE001
                record["error"] = str(e)
            if attempt < 2:
                time.sleep(1 + attempt * 2)
        else:
            ok = False
            log("couldn't send to", sub.get("name") or sub["id"], record.get("error"))
    return ok


# ---- the loop ------------------------------------------------------------------------------------

def sources(subs):
    out = {}
    for s in subs:
        src = Source(s.get("session"), find_herdr(s), find_board(s))
        out.setdefault(src.key, (src, []))[1].append(s)
    return out


def tick(state, n, dry_run=False, now=None):
    subs = subscribers()
    sent = {}
    now = time.time() if now is None else now
    for key, (src, group) in sources(subs).items():
        st = state.setdefault("sessions", {}).setdefault(key, {})
        live = any(s.get("live") for s in group)
        events = []
        agents = tasks = None
        # What the journal saw last; its first look only learns how things stand.
        jst = st.setdefault("journal", {})
        noted = []
        if src.herdr:
            try:
                snap = src.snapshot()
                first = "agents" not in st
                events += agent_events(src, snap, st.setdefault("agents", {}), first)
                learn = "agents" not in jst or first
                noted += journal_agents(snap, jst.setdefault("agents", {}), learn, now)
                if live:
                    agents = live_agents(snap, st, now)
                st.pop("problem", None)
            except Exception as e:  # noqa: BLE001
                if st.get("problem") != str(e):
                    log("herdr session %s:" % key, e)
                st["problem"] = str(e)
        if src.board and (n % BOARD_EVERY == 0 or "tasks" not in st):
            try:
                first = "tasks" not in st
                listed = src.tasks()
                events += task_events(listed, st.setdefault("tasks", {}), first)
                learn = "tasks" not in jst or first
                noted += journal_tasks(listed, jst.setdefault("tasks", {}), learn, now)
                if live:
                    tasks = live_tasks(src, listed, st, now)
            except Exception as e:  # noqa: BLE001
                log("board:", e)
        try:
            if noted:
                journal_add(key, noted, now)
            elif "at" not in jst:
                journal_start(key, now)
            # Up to when the journal is complete (the watcher may be stopped for a while).
            jst["at"] = int(now)
        except Exception as e:  # noqa: BLE001 - the journal is a nicety next to the pushes
            log("journal:", e)
        if live:
            ev = live_event(st, agents, tasks, now, first="live_sent" not in st)
            if ev is not None:
                events.append(ev)
        else:
            for k in ("live_sent", "live_agents", "live_tasks", "live_agents_since", "live_tasks_since", "review_rounds"):
                st.pop(k, None)
        if not events:
            continue
        sent[key] = events
        for sub in group:
            record = state.setdefault("phones", {}).setdefault(sub["id"], {})
            if gone(record, sub):
                continue
            mine = [e for e in events if e.get("type") != "live" or sub.get("live")]
            if dry_run or not mine:
                continue
            send(sub, mine, record)
    if subs:
        ev = health_look(state.setdefault("health", {}), now)
        if ev is not None:
            sent["@health"] = [ev]
            for sub in subs:
                record = state.setdefault("phones", {}).setdefault(sub["id"], {})
                if not dry_run and not gone(record, sub):
                    send(sub, [ev], record)
        try:
            quick = quick_look(state.setdefault("quick", {}), now)
        except Exception as e:  # noqa: BLE001 - a nicety next to the agents
            log("quick commands:", e)
            quick = []
        if quick:
            sent["@quick"] = quick
            for sub in subs:
                record = state.setdefault("phones", {}).setdefault(sub["id"], {})
                if not dry_run and not gone(record, sub):
                    send(sub, quick, record)
    return sent


def run():
    os.makedirs(STATE_DIR, exist_ok=True)
    # Not "w": that would wipe the running watcher's pid before finding out it runs.
    lock = open(LOCK, "a+")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        log("already running")
        return 0
    lock.seek(0)
    lock.truncate()
    lock.write(str(os.getpid()))
    lock.flush()
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    log(NAME, VERSION, "watching for", len(subscribers()), "phone(s)")
    state = read_json(STATE, {})
    n = 0
    while True:
        if not subscribers():
            time.sleep(30)
            continue
        try:
            # `test` notes how its sends went in the same file: keep that.
            state["phones"] = read_json(STATE, {}).get("phones", state.get("phones", {}))
            tick(state, n)
            write_json(STATE, state)
        except Exception as e:  # noqa: BLE001 - keep watching
            log("tick failed:", e)
        n += 1
        time.sleep(INTERVAL)


def running_pid():
    """The watcher's pid while one holds the lock, else None."""
    try:
        f = open(LOCK, "r+")
    except OSError:
        return None
    with f:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            f.seek(0)
            pid = f.read().strip()
            return int(pid) if pid.isdigit() else -1
        fcntl.flock(f, fcntl.LOCK_UN)
        return None


# ---- commands ------------------------------------------------------------------------------------

def out(value):
    print(json.dumps(value))


def cmd_subscribe():
    try:
        sub = json.loads(sys.stdin.read())
        key = base64.b64decode(sub["key"])
    except Exception as e:  # noqa: BLE001
        out({"ok": False, "msg": "bad subscription: %s" % e})
        return 2
    endpoint = str(sub.get("endpoint", ""))
    if len(key) != 32 or not sub.get("id") or not endpoint.startswith(("https://", "http://")):
        out({"ok": False, "msg": "a subscription needs an id, an http(s) endpoint and a 32-byte key"})
        return 2
    keep = ("id", "name", "endpoint", "key", "session", "herdr", "board", "live")
    entry = {k: sub[k] for k in keep if sub.get(k)}
    entry["since"] = time.time()
    subs = [s for s in subscribers() if s["id"] != entry["id"]] + [entry]
    write_json(SUBSCRIBERS, subs, private=True)
    out({"ok": True, "msg": "subscribed", "phones": len(subs), "version": VERSION})
    return 0


def cmd_unsubscribe(pid):
    subs = subscribers()
    left = [s for s in subs if s["id"] != pid]
    write_json(SUBSCRIBERS, left, private=True)
    out({"ok": True, "msg": "unsubscribed" if len(left) < len(subs) else "not subscribed", "phones": len(left)})
    return 0


def cmd_test(pid=None):
    subs = [s for s in subscribers() if pid in (None, s["id"])]
    if not subs:
        out({"ok": False, "msg": "no phone subscribed" if pid is None else "this phone isn't subscribed"})
        return 1
    state = read_json(STATE, {})
    results = []
    for s in subs:
        record = state.setdefault("phones", {}).setdefault(s["id"], {})
        ok = send(s, [{"type": "test"}], record)
        results.append({"id": s["id"], "ok": ok, "error": record.get("error")})
    write_json(STATE, state)
    good = all(r["ok"] for r in results)
    out({"ok": good, "msg": "sent" if good else (results[0].get("error") or "couldn't send"), "phones": results})
    return 0 if good else 1


def autostart():
    if sys.platform == "darwin":
        return "launchd" if os.path.exists(launchd_plist()) else "none"
    if os.path.exists(systemd_unit()):
        return "systemd"
    try:
        tab = subprocess.run(["crontab", "-l"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout.decode()
        if NAME in tab:
            return "cron"
    except OSError:
        pass
    return "none"


def cmd_status():
    state = read_json(STATE, {})
    phones = []
    for s in subscribers():
        r = state.get("phones", {}).get(s["id"], {})
        phones.append({"id": s["id"], "name": s.get("name", ""), "server": urllib.parse.urlsplit(s["endpoint"]).netloc,
                       "ok": r.get("ok"), "error": r.get("error"), "gone": gone(r, s)})
    problems = {k: v["problem"] for k, v in state.get("sessions", {}).items() if v.get("problem")}
    pid = running_pid()
    out({"ok": True, "version": VERSION, "running": pid is not None, "pid": pid, "autostart": autostart(),
         "phones": phones, "problems": problems, "path": os.path.abspath(__file__)})
    return 0


def start_background():
    os.makedirs(STATE_DIR, exist_ok=True)
    logf = open(LOG, "a")
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "run"], stdin=subprocess.DEVNULL, stdout=logf,
                     stderr=logf, start_new_session=True, close_fds=True)
    for _ in range(20):
        if running_pid() is not None:
            return True
        time.sleep(0.1)
    return running_pid() is not None


def cmd_ensure():
    if running_pid() is None:
        kind = autostart()
        if kind == "systemd":
            subprocess.run(["systemctl", "--user", "restart", NAME], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            time.sleep(0.5)
        if running_pid() is None:
            start_background()
    return cmd_status()


def systemd_unit():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
    return os.path.join(base, "systemd", "user", NAME + ".service")


def launchd_plist():
    return os.path.join(HOME, "Library", "LaunchAgents", "dev.herdr.push.plist")


def has_systemd():
    try:
        return subprocess.run(["systemctl", "--user", "show-environment"], stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL, timeout=10).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def cmd_install():
    me = os.path.abspath(__file__)
    note = ""
    if sys.platform == "darwin":
        plist = launchd_plist()
        os.makedirs(os.path.dirname(plist), exist_ok=True)
        with open(plist, "w") as f:
            f.write(LAUNCHD % {"py": sys.executable, "me": me, "log": LOG})
        subprocess.run(["launchctl", "unload", plist], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["launchctl", "load", "-w", plist], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif has_systemd():
        unit = systemd_unit()
        os.makedirs(os.path.dirname(unit), exist_ok=True)
        with open(unit, "w") as f:
            f.write(SYSTEMD % {"py": sys.executable, "me": me})
        if running_pid() is not None:
            stop()
        for args in (["daemon-reload"], ["enable", NAME], ["restart", NAME]):
            subprocess.run(["systemctl", "--user"] + args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        # Without lingering, user services stop when the last login ends and start with the next one.
        user = os.environ.get("USER") or os.path.basename(HOME)
        linger = subprocess.run(["loginctl", "show-user", user, "-p", "Linger"], stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL).stdout.decode().strip()
        if linger != "Linger=yes":
            try:
                subprocess.run(["loginctl", "enable-linger", user], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL, timeout=10)
            except (OSError, subprocess.TimeoutExpired):
                pass
            linger = subprocess.run(["loginctl", "show-user", user, "-p", "Linger"], stdout=subprocess.PIPE,
                                    stderr=subprocess.DEVNULL).stdout.decode().strip()
            if linger != "Linger=yes":
                note = "it stops when you log out (loginctl enable-linger %s keeps it running)" % user
    elif shutil.which("crontab"):
        tab = subprocess.run(["crontab", "-l"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout.decode()
        lines = [l for l in tab.splitlines() if NAME not in l]
        lines.append("@reboot %s %s ensure >/dev/null 2>&1" % (sys.executable, me))
        subprocess.run(["crontab", "-"], input=("\n".join(lines) + "\n").encode(), stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL)
    else:
        note = "nothing starts it with the machine: the app starts it again when it connects"
    for _ in range(30):
        if running_pid() is not None:
            break
        time.sleep(0.1)
    if running_pid() is None:
        start_background()
    pid = running_pid()
    out({"ok": pid is not None, "msg": note or "running", "autostart": autostart(), "pid": pid, "version": VERSION})
    return 0 if pid is not None else 1


def stop():
    pid = running_pid()
    if pid and pid > 0:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
        for _ in range(30):
            if running_pid() is None:
                break
            time.sleep(0.1)


def cmd_uninstall(purge):
    if sys.platform == "darwin" and os.path.exists(launchd_plist()):
        subprocess.run(["launchctl", "unload", "-w", launchd_plist()], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        os.remove(launchd_plist())
    if os.path.exists(systemd_unit()):
        subprocess.run(["systemctl", "--user", "disable", "--now", NAME], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        os.remove(systemd_unit())
        subprocess.run(["systemctl", "--user", "daemon-reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if shutil.which("crontab"):
        tab = subprocess.run(["crontab", "-l"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout.decode()
        if NAME in tab:
            lines = [l for l in tab.splitlines() if NAME not in l]
            subprocess.run(["crontab", "-"], input=("\n".join(lines) + "\n").encode(), stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL)
    stop()
    if purge:
        shutil.rmtree(CONFIG_DIR, ignore_errors=True)
        shutil.rmtree(STATE_DIR, ignore_errors=True)
    out({"ok": True, "msg": "removed"})
    return 0


def cmd_once(dry_run):
    state = read_json(STATE, {})
    sent = tick(state, 0, dry_run=dry_run)
    write_json(STATE, state)
    out({"ok": True, "events": sent})
    return 0


def cmd_journal(session, since):
    """What happened in herdr session [session] since [since] (seconds), oldest first."""
    key = session or "default"
    s = (read_json(JOURNAL, {}).get("sessions") or {}).get(key) or {}
    upto = (((read_json(STATE, {}).get("sessions") or {}).get(key) or {}).get("journal") or {}).get("at")
    entries = [e for e in s.get("entries", []) if isinstance(e, dict) and float(e.get("at") or 0) >= since]
    out({"ok": True, "version": VERSION, "now": int(time.time()), "from": s.get("from"), "upto": upto,
         "running": running_pid() is not None, "entries": entries})
    return 0


