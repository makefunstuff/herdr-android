API_BASE = os.environ.get("HERDR_USAGE_API", "").rstrip("/")
# How long a provider's answer is kept before it is asked again (seconds); --fresh asks at once
# (but not twice within FRESH_MIN: a pull to refresh shouldn't hammer a usage API).
LIVE_TTL = float(os.environ.get("HERDR_USAGE_TTL", "240"))
FRESH_MIN = min(20, LIVE_TTL)
# The days the chart shows, and how long a pass over the session records may take before it stops
