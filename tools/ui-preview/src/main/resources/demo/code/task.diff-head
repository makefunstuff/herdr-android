@@ -6,6 +6,7 @@ object LastAnswered {
         if (at == null) return "never answered"
         val seconds = (now - at) / 1000
         return when {
+            seconds < 60 -> "just now"
             seconds < 3600 -> "${seconds / 60} min ago"
             seconds < 86_400 -> "${seconds / 3600} h ago"
             else -> "${seconds / 86_400} days ago"
diff --git a/core/src/test/kotlin/demo/herdr/core/LastAnsweredTest.kt b/core/src/test/kotlin/demo/herdr/core/LastAnsweredTest.kt
