def find(tid):
    for k, t in TASKS:
        if t["id"] == tid or k == tid:
            return k, t
    return None, None

def details(tid):
    k, t = find(tid)
    if t is None:
        print(f"No task {tid}"); sys.exit(1)
    d = DETAILS.get(t["id"]) or {
        "task": {"id": k, "title": t["title"], "stage": t.get("stage", ""), "msg": t.get("msg", ""), "description": ""},
        "failure": None, "reviews": [], "agent": t.get("app", ""), "handovers": [], "research": t.get("research", False),
        "plan": "", "pr": t.get("pr", ""), "branch": "", "worktree": "", "limits": {},
    }
    print(json.dumps(d, indent=2))

args = sys.argv[1:]
if args[:2] == ["remote", "list"]:
    print(json.dumps({"host": "devbox", "version": "0.9.0", "tasks": [], "coordinator": {"state": "idle", "queue": 0, "readable": True, "said": talk[-1]["text"], "sent": "", "talk": talk}}))
elif args[:2] == ["remote", "dispatch"]:
    req = json.loads(base64.b64decode(args[2]))
    talk.append({"you": True, "text": req["text"]})
    json.dump(talk, open(store, "w"))
    print(json.dumps({"ok": True, "msg": "Sent to the Coordinator"}))
elif args[:1] == ["list"]:
    shown = [] if "--archived" in args else TASKS
    if "--query" in args:
        q = args[args.index("--query") + 1].lower()
        shown = [(k, t) for k, t in shown if q in t["title"].lower() or q in k.lower()]
    if "--json" in args:
        print(json.dumps([t for _, t in shown], indent=2))
    else:
        for k, t in shown:
            print(f"{k} {t['title']}")
elif args[:1] == ["details"] and len(args) > 1:
    details(args[1])
elif args and args[0] in ("delegate", "tell", "stop", "retry", "fix", "review", "finish", "approve", "pick", "archive", "restore", "clear", "pin", "add", "edit"):
    print("Done (demo board)")
else:
    print(json.dumps({"ok": False, "msg": "demo board"}))
