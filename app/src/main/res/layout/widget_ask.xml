<?xml version="1.0" encoding="utf-8"?>
<!-- The Ask widget: the Coordinator's icon on its tile, "Ask the Coordinator", and the machine it opens. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <!-- A widget is RemoteViews, drawn by the launcher without AppCompat: only android:tint works here. -->
    <ImageView
        tools:ignore="UseAppTint"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/widget_tile"
        android:contentDescription="@null"
        android:padding="8dp"
        android:src="@drawable/ic_coordinator"
        android:tint="@color/widget_accent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/widget_ask"
            android:textColor="@color/widget_strong"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_machine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
