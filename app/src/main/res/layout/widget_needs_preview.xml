<?xml version="1.0" encoding="utf-8"?>
<!-- The Needs you widget as the widget picker shows it, with made-up rows (the real ones: widget_needs_row). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="28dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/geist_mono_medium"
            android:letterSpacing="0.08"
            android:text="@string/widget_needs_heading"
            android:textColor="@color/widget_text"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/geist_mono_medium"
            android:text="2"
            android:textColor="@color/widget_blocked"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/geist_medium"
                android:maxLines="1"
                android:text="HERD-4 · Finished"
                android:textColor="@color/widget_strong"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/geist_regular"
                android:maxLines="1"
                android:text="Dark mode for the board"
                android:textColor="@color/widget_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            style="@style/HerdrWidgetButton"
            android:background="@drawable/widget_button"
            android:text="Accept"
            android:textColor="@color/widget_panel"
            android:visibility="visible" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/geist_medium"
                android:maxLines="1"
                android:text="api needs you"
                android:textColor="@color/widget_strong"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/geist_regular"
                android:maxLines="1"
                android:text="Run the migrations?"
                android:textColor="@color/widget_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            style="@style/HerdrWidgetButton"
            android:background="@drawable/widget_button"
            android:text="Approve"
            android:textColor="@color/widget_panel"
            android:visibility="visible" />

        <TextView
            style="@style/HerdrWidgetButton"
            android:background="@drawable/widget_button_framed"
            android:text="Deny"
            android:textColor="@color/widget_text"
            android:visibility="visible" />
    </LinearLayout>
</LinearLayout>
