<?xml version="1.0" encoding="utf-8"?>
<!-- A widget's card: the app's panel colour with its hairline, at the launcher's own corner radius. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_panel" />
    <stroke android:width="1dp" android:color="@color/widget_line" />
    <corners android:radius="@android:dimen/system_app_widget_background_radius" />
</shape>
