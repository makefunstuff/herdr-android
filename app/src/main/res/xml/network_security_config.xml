<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP only to the phone itself: the dev server screen shows a machine's dev server, and the
     coordinator's voice reaches a plain-http voice server (LFM3, `local-ai-mode edge`), each through a
     port of the phone's loopback forwarded over the machine's SSH connection. Everything else stays
     HTTPS only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
