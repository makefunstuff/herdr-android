<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP only to the phone itself and the owner's voice server: the dev server screen shows a
     machine's dev server through a port of the phone's loopback forwarded over SSH, and the voice
     server (LFM3, `local-ai-mode edge`) speaks plain HTTP on the home network, reached from away by
     WireGuard. Everything else stays HTTPS only (another voice server needs https, or a line here). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">192.168.1.138</domain>
    </domain-config>
</network-security-config>
