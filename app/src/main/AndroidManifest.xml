<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Notifications while the app is closed (push/): posting them, the service that answers from them
         or looks at the machines, the exact alarm for those looks, and setting it again after a restart. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- The brief read aloud goes on with the screen off or the app closed: a foreground service that plays speech. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Live Updates (Android 16): running tasks and agents as promoted notifications with a status bar chip. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- "Latest screenshot" in the chat composer: finding the newest picture in the Screenshots folder.
         Asked for only when that is tapped (on Android 14, leave for only some photos is enough); the
         gallery and the camera need no permission. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- Push apps (UnifiedPush distributors such as ntfy) that give the app an address for its machines. -->
    <queries>
        <intent><action android:name="org.unifiedpush.android.distributor.REGISTER" /></intent>
        <!-- The phone's text to speech, which reads the brief aloud. -->
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>

    <application
        android:name=".HerdrApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Herdr">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- A chat floating over other apps: an Android bubble's window (resizable and embedded, one
             document per chat), and Float on a notification, which floats the agent's chat and closes. -->
        <activity
            android:name=".bubble.BubbleActivity"
            android:exported="false"
            android:allowEmbedded="true"
            android:documentLaunchMode="always"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode" />
        <activity
            android:name=".bubble.FloatActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Herdr.Invisible" />

        <!-- Asking the Coordinator from anywhere: the share sheet and "Send to Coordinator" next to Copy
             land here, which hands what was shared to MainActivity in the app's own task. -->
        <activity
            android:name=".share.ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:label="@string/share_to_coordinator"
            android:icon="@mipmap/ic_launcher"
            android:theme="@style/Theme.Herdr.Invisible">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter android:label="@string/send_to_coordinator">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- The file the camera app writes a photo for the chat composer into. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
        <!-- The Quick Settings tile that opens the Coordinator chat. -->
        <service
            android:name=".share.CoordinatorTile"
            android:exported="true"
            android:icon="@drawable/ic_coordinator"
            android:label="@string/tile_coordinator"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- The home-screen widgets: one that opens the Coordinator chat, one with the counts across machines. -->
        <receiver
            android:name=".share.AskWidget"
            android:exported="false"
            android:label="@string/widget_ask">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_ask_info" />
        </receiver>
        <receiver
            android:name=".share.StatusWidget"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_status_info" />
        </receiver>

        <!-- A notification's button, the app's own look at its machines while it is closed, the scheduled
             brief, and the brief read aloud. -->
        <service android:name=".push.WorkService" android:exported="false" android:foregroundServiceType="dataSync|mediaPlayback" />
        <!-- The alarm for that look, set again when the phone restarts or the app updates. -->
        <receiver android:name=".push.WakeReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Quiet hours: the alarm that looks whether they ended, set again after a restart, an update,
             or a change of the clock or time zone. -->
        <receiver android:name=".push.QuietReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
        <!-- The brief's alarm at the times chosen, set again after a restart, an update, or a change of the
             clock or time zone. -->
        <receiver android:name=".brief.BriefReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
        <!-- A Live Update's Stop for a task, which asks first, and Keep going. -->
        <receiver android:name=".push.LiveReceiver" android:exported="false" />
        <!-- Pushes from the machines through a push app (UnifiedPush). Only its token is taken, and only
             pushes sealed with a machine's own key are shown. -->
        <receiver android:name=".push.PushReceiver" android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
